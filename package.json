{
  "name": "vite-preact-ts-template",
  "private": true,
  "version": "1.0.0-alpha",
  "type": "module",
  "scripts": {
    "build": "tsc && vite build",
    "lint": "eslint .",
    "lint:fix": "npm run lint -- --fix",
